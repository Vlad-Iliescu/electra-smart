# Copy to secrets.yaml and fill in. secrets.yaml is gitignored.
wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"

# Fallback hotspot the node raises if it cannot reach the WiFi.
fallback_password: "electra-setup"

# Home Assistant API encryption key. Generate a fresh 32-byte base64 key with:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
api_key: "replace-with-a-generated-base64-key"

ota_password: "choose-an-ota-password"
